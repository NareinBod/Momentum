Net Sales = SUM(fact_sales[net_sales])
Gross Profit = SUM(fact_sales[gross_profit])
Gross Margin % = DIVIDE([Gross Profit], [Net Sales])
Units Sold = SUM(fact_sales[quantity])
Average Inventory Turnover = AVERAGE(inventory_metrics[inventory_turnover])
Products At Stockout Risk = CALCULATE(COUNTROWS(demand_forecast), demand_forecast[stockout_risk] = TRUE())
Average Supplier Risk = AVERAGE(supplier_performance[supplier_risk_score])
High Risk Suppliers = CALCULATE(COUNTROWS(supplier_performance), supplier_performance[risk_band] = "High")
Forecast Units (30D) = SUM(demand_forecast[forecast_units])
Median Days To Stockout = MEDIAN(demand_forecast[days_to_stockout])
Reorder Quantity Value = SELECTEDVALUE('Reorder Quantity'[Reorder Quantity], 120)
Lead Time Days Value = SELECTEDVALUE('Lead Time Days'[Lead Time Days], 21)
Demand During Lead Time = SUMX(demand_forecast, demand_forecast[forecast_daily_units] * [Lead Time Days Value])
Projected Stock At Arrival = SUM(demand_forecast[estimated_on_hand]) + ([Reorder Quantity Value] * COUNTROWS(demand_forecast)) - [Demand During Lead Time]
